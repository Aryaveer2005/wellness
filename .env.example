# Copy this file to .env.local and fill in your keys. NEVER commit .env.local.
# All keys are server-only (read in src/lib/server/*). Never prefix them with NEXT_PUBLIC_.
# Full details: docs/AI_CHATBOT.md

# --- NVIDIA AI (build.nvidia.com) ---
# Topic guard (Llama 3.1 NemoGuard 8B Topic Control). Also used for chat replies if NVIDIA_CHAT_API_KEY is empty.
NVIDIA_GUARD_API_KEY=
# Optional: separate key + model for companion replies / reframer hints
NVIDIA_CHAT_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Image — FLUX.2 [klein] 4B ("suggested expression" in the Confidence boost)
NVIDIA_IMAGE_API_KEY=
# Voice — Chatterbox Multilingual TTS (gRPC via NVCF)
NVIDIA_TTS_API_KEY=
NVIDIA_TTS_FUNCTION_ID=ddacc747-1269-4fab-bfd9-8f593dead106
NVIDIA_TTS_VOICE=Chatterbox-Multilingual.en-US.Male
# Speech-to-text for chat voice mode — NVIDIA Parakeet (defaults to the TTS key)
NVIDIA_ASR_API_KEY=
NVIDIA_ASR_FUNCTION_ID=d3fe9151-442b-4204-a70d-5fcc597fd610
NVIDIA_ASR_LANGUAGE=en-US

# --- Anthropic (optional fallback for chat + hints) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Places API (New) — "Top 5 near me" (server-only; restrict the key to Places API (New) + set a budget alert) ---
# Without it, nearby results fall back to OpenStreetMap (names/addresses, no ratings).
GOOGLE_PLACES_API_KEY=

# --- Supabase (optional account / cloud sync) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
